{
  "expo": {
    "name": "Kitom",
    "slug": "kitom",
    "version": "1.1.0",
    "description": "Bienestar emocional y conductual de perros y gatos: registro diario, agenda, logros y orientación con IA, que no sustituye al veterinario.",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon/app-icon-ios.png",
    "scheme": "kitom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kitom.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kitom.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0E3B39",
        "foregroundImage": "./assets/brand/app-icon/android-adaptive-foreground.png",
        "backgroundImage": "./assets/brand/app-icon/android-adaptive-background.png",
        "monochromeImage": "./assets/brand/app-icon/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F5F3",
          "image": "./assets/brand/app-icon/splash-icon.png",
          "imageWidth": 230
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/app-icon/android-notification.png",
          "color": "#0E3B39"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitom necesita acceder a tus fotos para añadir la foto de tu mascota.",
          "cameraPermission": "Kitom necesita la cámara para hacer la foto de tu mascota.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "organization": "kitom",
          "project": "kitom-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
