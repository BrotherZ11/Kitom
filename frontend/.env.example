# Copiar a frontend/.env (ignorado por git). Expo solo lee el .env de esta carpeta.
# Todo EXPO_PUBLIC_* se incrusta en el bundle de la app: NUNCA pongas aquí service_role,
# claves de IA, secretos de RevenueCat ni nada privado.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
